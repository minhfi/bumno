# Local Postgres (localhost:5432)
DATABASE_URL="postgresql://<user>@localhost:5432/bumno"
# Database used by integration tests and Playwright E2E (wiped by tests)
DATABASE_URL_TEST="postgresql://<user>@localhost:5432/bumno_test"

# Single admin password for /admin
ADMIN_PASSWORD="change-me"
# Secret used to sign the admin session cookie (at least 32 characters)
SESSION_SECRET="replace-with-a-random-string-of-at-least-32-chars"
